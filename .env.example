# Application Name
APP_NAME="Storage"

# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# S3 (AWS S3 or any S3-compatible storage such as Cloudflare R2)
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_REGION="auto"

# Docker production stack (compose.prod.yaml)
# Use a URL-safe password, e.g. `openssl rand -hex 24`
POSTGRES_USER="storage"
POSTGRES_PASSWORD=""
POSTGRES_DB="storage"
# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token
CLOUDFLARE_TUNNEL_TOKEN=""
