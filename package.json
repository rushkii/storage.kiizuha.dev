{
    "name": "storage.kiizuha.dev",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "imports": {
        "#ui/*/index.js": "./src/lib/components/ui/*/index.ts",
        "#ui/*.svelte": "./src/lib/components/ui/*.svelte",
        "#ui/*": "./src/lib/components/ui/*/index.ts",
        "#icons/*": "./src/lib/components/icons/*",
        "#table/*": "./src/lib/components/table/*",
        "#components/*": "./src/lib/components/*",
        "#server/*": "./src/lib/server/*",
        "#lib/*": "./src/lib/*",
        "#lib": "./src/lib/index.ts",
        "#app-types": "./src/app.d.ts"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write . && pnpm fix-tailwind",
        "fix-tailwind": "pnpm dlx @laststance/tailwind-suggest-canonical-classes 'src/**/*.{tsx,jsx,svelte,html}' --fix",
        "db:start": "docker compose up",
        "db:push": "drizzle-kit push",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@fontsource-variable/inter": "^5.3.0",
        "@internationalized/date": "^3.12.4",
        "@sveltejs/adapter-node": "^6.0.5",
        "@sveltejs/enhanced-img": "^1.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^24",
        "auth": "^1.6.24",
        "better-auth": "^1.6.24",
        "bits-ui": "^2.21.0",
        "cn": "^0.5.2",
        "drizzle-kit": "^0.31.10",
        "drizzle-orm": "^0.45.2",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.19.0",
        "globals": "^17.6.0",
        "mdsvex": "^0.12.7",
        "postgres": "^3.4.9",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "shadcn-svelte": "^1.8.1",
        "svelte": "^5.57.2",
        "svelte-check": "^4.6.0",
        "svelte-sonner": "^1.2.3",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.1",
        "vite": "^8.3.0"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1171.0",
        "@aws-sdk/s3-request-presigner": "^3.1171.0",
        "@lucide/svelte": "^1.80.0",
        "@tanstack/table-core": "^8.21.3",
        "client-zip": "^2.5.1",
        "clsx": "^2.1.1",
        "mode-watcher": "^1.1.0",
        "svelte-dnd-action": "^0.9.80",
        "tailwind-merge": "^3.7.0",
        "valibot": "^1.5.0"
    }
}
